# Personal AI Employee - Environment Variables Example
# Copy this file to .env and fill in your actual credentials

#                 ========================================================
#                          GMAIL CONFIGURATION VARIABLES
#                 =========================================================

# Gmail API credentials for email monitoring
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_ACCESS_TOKEN=your_gmail_access_token_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
GMAIL_USER_EMAIL=your_gmail_account_email_here

# Set to true for dry run mode (no actual email processing)
GMAIL_DRY_RUN=true

#                 ========================================================
#                          LINKEDIN CONFIGURATION VARIABLES
#                 =========================================================

# LinkedIn credentials for posting and monitoring
LINKEDIN_USERNAME=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ORG_URN=your_linkedin_org_urn_here
LINKEDIN_PERSON_URN=your_linkedin_person_urn_here
LINKEDIN_PERSON_ID=your_linkedin_person_id_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Path to store LinkedIn session data
LINKEDIN_SESSION_PATH=./linkedin_session

# Set to true for dry run mode (no actual posting)
LINKEDIN_DRY_RUN=true

#                 ========================================================
#                          TWITTER/X CONFIGURATION VARIABLES
#                 =========================================================

# Twitter/X API credentials
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET_KEY=your_twitter_api_secret_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_ACCOUNT_PASSWORD=your_twitter_password_here
TWITTER_ACCOUNT_EMAIL=your_twitter_email_here
TWITTER_URL=https://x.com/home

#                 ========================================================
#                          FACEBOOK/INSTAGRAM CONFIGURATION VARIABLES
#                 =========================================================

# Facebook API credentials
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
APP_TOKEN=your_facebook_app_token_here

# Instagram API credentials
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

#                 ========================================================
#                          ODOO CONFIGURATION VARIABLES
#                 =========================================================

# Odoo Server URL (for Odoo Online - SaaS deployment)
ODOO_URL=https://your-odoo-subdomain.odoo.com

# Odoo Database Name (for Odoo Online, this is typically the subdomain)
ODOO_DATABASE=your_odoo_database_name_here

# Odoo credentials
ODOO_USERNAME=your_odoo_email_here
EMAIL=your_odoo_email_here
ODOO_API_KEY=your_odoo_api_key_here
ODOO_DB_PASSWORD=your_odoo_database_password_here
ODOO_ADMIN_PASSWORD=your_odoo_admin_password_here

#                 ========================================================
#                          WHATSAPP CONFIGURATION VARIABLES
#                 =========================================================

# WhatsApp Business API credentials
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# Path to store WhatsApp session data
WHATSAPP_SESSION_PATH=./whatsapp_session

# Set to true for dry run mode (no actual messaging)
WHATSAPP_DRY_RUN=true

#                 ========================================================
#                          COMPOSIO CONFIGURATION VARIABLES
#                 =========================================================

# Composio API key (if needed for advanced features)
COMPOSIO_API_KEY=your_composio_api_key_here

#                 ========================================================
#                          BROWSER/PAYMENT CONFIGURATION VARIABLES
#                 =========================================================

# Set to true for dry run mode (no actual browser interactions for payments)
BROWSER_DRY_RUN=true
PAYMENT_DRY_RUN=true

#                 ========================================================
#                          CALENDAR CONFIGURATION VARIABLES
#                 =========================================================

# Set to true for dry run mode (no actual calendar interactions)
CALENDAR_DRY_RUN=true

#                 ========================================================
#                          APPLICATION SETTINGS VARIABLES
#                 =========================================================

# Set to true for dry run mode (no actual operations)
DRY_RUN=true

# Set log level (debug, info, warning, error)
LOG_LEVEL=info

# Time interval for checking new emails and processing tasks (in seconds)
CHECK_INTERVAL=120